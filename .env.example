# Copy to .env (in packages/server or the directory you start the server from) and edit.

PORT=8080
# HOST=0.0.0.0

# RPC urls per chain (comma separated, the first one is preferred). Public RPCs are rate limited:
# use your own node or a provider for reliable results.
# RPC_URL_ETHEREUM=https://...
# RPC_URL_BSC=https://...
# RPC_URL_BASE=https://...
# RPC_URL_ARBITRUM=https://...
# RPC_URL_POLYGON=https://...
# RPC_URL_AVALANCHE=https://...
# RPC_URL_OPTIMISM=https://...
# RPC_URL_GNOSIS=https://...
# RPC_URL_FANTOM=https://...

# CORS_ORIGINS=https://my-site.example
# RATE_LIMIT_PER_MINUTE=30
# CACHE_TTL_SECONDS=30
# TRUST_PROXY=1

# Thresholds (%)
# MAX_BUY_TAX=10
# MAX_SELL_TAX=10
# HONEYPOT_TAX=90

# Built web app to serve (empty = API only)
# WEBAPP_DIR=
